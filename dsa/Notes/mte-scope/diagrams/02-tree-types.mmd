graph TB
  subgraph P1["BINARY<br/>at most two children per node"]
    direction TB
    A1(("A")) --> A2(("B"))
    A1 --> A3(("C"))
  end
  subgraph P2["FULL, or strictly binary<br/>two children or none, never one"]
    direction TB
    B1(("A")) --> B2(("B"))
    B1 --> B3(("C"))
    B2 --> B4(("D"))
    B2 --> B5(("E"))
  end
  subgraph P3["COMPLETE<br/>levels full, last filled from the left"]
    direction TB
    C1(("A")) --> C2(("B"))
    C1 --> C3(("C"))
    C2 --> C4(("D"))
    C2 --> C5(("E"))
  end
  subgraph P4["PERFECT<br/>full at every node, all leaves level"]
    direction TB
    D1(("A")) --> D2(("B"))
    D1 --> D3(("C"))
    D2 --> D4(("D"))
    D2 --> D5(("E"))
    D3 --> D6(("F"))
    D3 --> D7(("G"))
  end
  subgraph P5["SKEWED<br/>exactly one child per node, a chain"]
    direction TB
    E1(("A")) --> E2(("B"))
    E2 --> E3(("C"))
  end
  subgraph P6["THREADED<br/>an empty pointer becomes a thread"]
    direction TB
    F1(("A")) --> F2(("B"))
    F1 --> F3(("C"))
