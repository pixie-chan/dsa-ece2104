# compiled binaries and build leftovers
_build/
*.o
*.out
*.exe
a.out

# python
__pycache__/
*.pyc

# gate screenshots (regenerable, and they are megabytes of pixels)
# the **/ matters: a bare ".qa/*.png" only matches a .qa folder at the repo
# root, so the nested .qa in every notes project leaked through and landed
# in the history anyway. This form covers both.
ui-gate-*.png
review-*.png
zoom-*.png
**/.qa/*.png
shots/*.png

# course material that is not mine to republish (university handout, submissions)
Handouts/
*.pdf

# editor and OS noise
.DS_Store
.vscode/
.idea/
compile_commands.json

# build caches
.cache/
*.log
