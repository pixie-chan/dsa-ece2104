flowchart TD
  DS["Data structures"] --> P["Primitive: one value<br/>int, char, float, double, pointer"]
  DS --> C["Composite: many values as one unit"]
  C --> LIN["Linear: one predecessor, one successor"]
  C --> NLI["Non-linear: hierarchical or networked"]
  LIN --> AR["Array (static, contiguous)"]
  LIN --> LL["Linked list (dynamic, scattered)"]
  LIN --> SQ["Stack and queue (linear + a discipline)"]
  NLI --> TR["Tree: one parent, many children"]
  NLI --> GR["Graph: any connections, cycles allowed"]
  DS --> AX["Third axis: static (size fixed at compile time)<br/>or dynamic (grown at run time on the heap)"]
